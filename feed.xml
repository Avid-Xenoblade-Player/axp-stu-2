---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://w3.org">
  <channel>
    <title>More Or Less</title>
    <description>most recent updates</description>
    <link>https://avid-xenoblade-player.github.io</link>
    <pubDate>{{ site.time | date_to_rfc822 }}</pubDate>
    {% assign sorted_pages = site.html_pages | sort: "url" | reverse %}
    {% for page in sorted_pages limit:10 %}
      {% unless page.url == "/feed.xml" or page.url == "/index.html" or page.url == "/404.html" %}
      <item>
        <title>{{ page.title | default: "New Page" | xml_escape }}</title>
        <description>
          {% if page.panel_image %}
            &lt;img src="https://avid-xenoblade-player.github.io{{ page.panel_image }}" style="max-width:100%; display:block; margin-bottom:10px;" /&gt;
          {% endif %}
          {{ page.content | xml_escape }}
        </description>
        <link>https://avid-xenoblade-player.github.io{{ page.url }}</link>
        <guid isPermaLink="true">https://avid-xenoblade-player.github.io{{ page.url }}</guid>
      </item>
      {% endunless %}
    {% endfor %}
  </channel>
</rss>
